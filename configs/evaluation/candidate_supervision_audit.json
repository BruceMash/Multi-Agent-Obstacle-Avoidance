    "progress_weight": 1.0,
    "clearance_weight": 1.0,
    "deviation_weight": 1.0,
    "terminal_speed_weight": 1.0,
    "failure_margin": 0.001,
    "normalization": {
      "task_progress_scale": 0.32,
      "min_clearance_scale": 4.5,
      "max_execution_deviation_scale": 1.05,
      "terminal_speed_scale": 1.2,
      "version": "fp_shep_h4_v1"
    }
  },
  "proposal_config": {
    "top_k": 10
  },
  "graph_config": {
