    "d_align_source": "configurable_implementation_parameter_not_paper_constant"
  },
  "semantics": {
    "formal_graph_preview_horizon": 4,
    "null_branch_active_goal": "terminal_task_goal",
    "null_node_schema_changed": false,
    "forcing_gate_distance_source": "terminal_task_goal",
    "preview_observation_model": "frozen_visible_surface_approximation",
